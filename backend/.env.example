# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# The .env file is loaded by dotenv-rails and excluded from git.

# Required: OpenAI API key for real LLM/STT/TTS integration.
# Without a valid key, the app falls back to Ai::FakeClient (mock responses).
OPENAI_API_KEY=your-openai-api-key-here

# Optional: Frontend origin for CORS (default: http://localhost:5173)
FRONTEND_ORIGIN=http://localhost:5173
